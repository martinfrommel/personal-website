---
import { Icon } from "astro-icon/components";

interface Props {
  size?: number | undefined;
  className?: string;
}

interface Links {
  name: string;
  link: string;
  icon: string;
  target: "_self" | "_blank";
}

const links: Links[] = [
  {
    name: "Home",
    link: "/",
    icon: "pixelarticons:home",
    target: "_self",
  },
  {
    name: "Projects",
    link: "/projects",
    icon: "pixelarticons:folder",
    target: "_self",
  },
  {
    name: "GitHub",
    link: "https://github.com/martinfrommel",
    icon: "pixelarticons:git-pull-request",
    target: "_blank",
  },
  {
    name: "Reach me",
    link: "https://linkedin.com/in/martin-frommel",
    icon: "pixelarticons:message-processing",
    target: "_blank",
  },
];

const { size, className } = Astro.props;
---

{
  links.map((link) => (
    <li class="menuItem" aria-label={link.name}>
      <a
        aria-label={`Link to ${link.name}`}
        href={link.link}
        target={link.target || "_self"}
        class:list={[
          "flex flex-none flex-col flex-wrap items-center justify-center",
          className,
        ]}
      >
        <Icon name={link.icon} width={size} height={size} />
        <span class="font-mono xl:text-lg">{link.name}</span>
      </a>
    </li>
  ))
}
